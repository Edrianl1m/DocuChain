# ─────────────────────────────────────────────────────────────────
# DocuChain — online server settings (used by docker-compose.prod.yml)
# deploy/setup-server.sh writes .env for you (with random secrets);
# this file documents each setting. Never commit .env.
# ─────────────────────────────────────────────────────────────────

# Your domain, without https:// (its DNS A record must point to the server)
DOMAIN=docuchain.example.com
# Email for Let's Encrypt certificate notices
ACME_EMAIL=you@example.com

# First admin account password (username: admin). Change it after first login.
ADMIN_PASSWORD=

# Random secrets (setup-server.sh generates these)
JWT_SECRET=
POSTGRES_PASSWORD=
MEILI_MASTER_KEY=

JWT_EXPIRES_IN=8h
MAX_FILE_SIZE_MB=50
# Largest request Caddy accepts (keep ~10 MB above MAX_FILE_SIZE_MB)
MAX_REQUEST_MB=60
