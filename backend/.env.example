# ─────────────────────────────────────────────────────────────────
# DocuChain Backend — Environment Variables
# Copy to .env and fill in your values
# ─────────────────────────────────────────────────────────────────

# Server
PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=your-very-secret-key-change-this
JWT_EXPIRES_IN=8h

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=docuchain
DB_USER=docuchain_user
DB_PASSWORD=docuchain_pass

# MeiliSearch
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=docuchain-meili-secret-key
MEILI_INDEX=documents

# File Storage
UPLOAD_DIR=../uploads
MAX_FILE_SIZE_MB=50

# Hyperledger Fabric
FABRIC_CHANNEL=docuchain
FABRIC_CHAINCODE=docuchain-cc
FABRIC_MSP_ID=Org1MSP
FABRIC_PEER_ENDPOINT=grpcs://localhost:7051
FABRIC_ORDERER_ENDPOINT=grpcs://localhost:7050

# Paths to Fabric crypto material (relative to backend/src/config)
FABRIC_CRYPTO_PATH=../../fabric-network/crypto-config
FABRIC_ADMIN_CERT=peerOrganizations/org1.docuchain.local/users/Admin@org1.docuchain.local/msp/signcerts/Admin@org1.docuchain.local-cert.pem
FABRIC_ADMIN_KEY_PATH=peerOrganizations/org1.docuchain.local/users/Admin@org1.docuchain.local/msp/keystore
FABRIC_PEER_TLS_CERT=peerOrganizations/org1.docuchain.local/peers/peer0.org1.docuchain.local/tls/ca.crt

# Frontend origin (for CORS)
FRONTEND_URL=http://localhost:5173
